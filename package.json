{
  "name": "openazoth",
  "private": true,
  "version": "0.2.1",
  "description": "OpenAzoth — configure the ROG Azoth keyboard in the browser (WebHID). Unofficial, not affiliated with ASUS.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/w3c-web-hid": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
